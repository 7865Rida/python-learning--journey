#Day7-Break & Continue
for i in range(7):
    if i == 5:
        break
    print(i)
    
for n in range(9):
    if n==7:
        continue
    print(n)
    
while True:
    print("Stop")
    break

for i in range(1,6):
    if i%2==0:
        continue
    print(i)

